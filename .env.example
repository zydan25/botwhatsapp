# Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Domains used by the same Node process behind your reverse proxy
ADMIN_HOST=admin.whatsapp.alattab.site
CLIENT_HOST=whatsapp.alattab.site

# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=production
TRUST_PROXY=true

# WhatsApp / Chromium
# Leave empty to use Puppeteer's bundled browser. Do not point this at a Snap wrapper.
CHROME_PATH=

# Optional default external API URL. HTTP and HTTPS are both supported.
API_BASE_URL=

# Incoming/outgoing media is memory-only. No upload files are persisted.
UPLOAD_MAX_BYTES=8388608
