# Required administrator credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Long random secret used to sign the HttpOnly authentication cookie
SESSION_SECRET=replace-with-a-long-random-secret

# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=production
# Set true only when the app is behind a trusted reverse proxy
TRUST_PROXY=false

# Optional
API_BASE_URL=
CHROME_PATH=/usr/bin/chromium-browser
# Maximum outgoing media upload size in bytes (default: 10 MiB)
UPLOAD_MAX_BYTES=10485760
